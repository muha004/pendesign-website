<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pendesign</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <nav>
        <div class="logo">Pendesign</div>

        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#products">Products</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>

        <button id="menu-btn">☰</button>
    </nav>
</header>

<section id="home" class="hero">
    <div class="hero-content">
        <h1>Creative Design Solutions</h1>
        <p>Helping businesses stand out through clean, modern, and impactful design.</p>
        <a href="#products" class="btn">View Products</a>
    </div>
</section>

<section id="about" class="section">
    <h2>About Us</h2>
    <p>
        Pendesign delivers minimalist and professional design solutions for businesses.
        Our focus is on quality, simplicity, and creating memorable visual experiences.
    </p>
</section>

<section id="products" class="section">
    <h2>Products</h2>

    <div class="product-grid">

        <div class="card">
            <h3>Logo Design</h3>
            <p>Professional branding and logo creation.</p>
        </div>

        <div class="card">
            <h3>Marketing Materials</h3>
            <p>Brochures, flyers, banners, and promotional assets.</p>
        </div>

        <div class="card">
            <h3>Website Design</h3>
            <p>Modern responsive websites for businesses.</p>
        </div>

    </div>
</section>

<section id="contact" class="section contact">
    <h2>Contact</h2>

    <p>Email: your@email.com</p>
    <p>Phone: +968 0000 0000</p>

    <div class="socials">
        <a href="#">Instagram</a>
        <a href="#">Facebook</a>
        <a href="#">LinkedIn</a>
    </div>
</section>

<footer>
    <p>© 2026 Pendesign. All rights reserved.</p>
</footer>

<script src="script.js"></script>
</body>
</html>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #222;
    line-height: 1.6;
    background: #fff;
}

header {
    position: sticky;
    top: 0;
    background: white;
    border-bottom: 1px solid #eee;
    z-index: 100;
}

nav {
    max-width: 1200px;
    margin: auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.4rem;
    font-weight: bold;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
}

.nav-links a {
    text-decoration: none;
    color: #222;
}

#menu-btn {
    display: none;
    border: none;
    background: none;
    font-size: 1.5rem;
    cursor: pointer;
}

.hero {
    min-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem;
}

.hero-content {
    max-width: 700px;
}

.hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.hero p {
    margin-bottom: 2rem;
}

.btn {
    background: #000;
    color: white;
    padding: 12px 24px;
    text-decoration: none;
    border-radius: 4px;
}

.section {
    max-width: 1200px;
    margin: auto;
    padding: 5rem 2rem;
}

.section h2 {
    margin-bottom: 2rem;
    text-align: center;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
    gap: 2rem;
}

.card {
    padding: 2rem;
    border: 1px solid #ddd;
    border-radius: 8px;
}

.card h3 {
    margin-bottom: 1rem;
}

.contact {
    text-align: center;
}

.socials {
    margin-top: 1rem;
}

.socials a {
    margin: 0 10px;
    text-decoration: none;
    color: black;
}

footer {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid #eee;
}

@media (max-width: 768px) {

    #menu-btn {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 70px;
        right: 20px;
        flex-direction: column;
        background: white;
        border: 1px solid #ddd;
        padding: 1rem;
    }

    .nav-links.show {
        display: flex;
    }

    .hero h1 {
        font-size: 2rem;
    }
}
const menuBtn = document.getElementById("menu-btn");
const navLinks = document.querySelector(".nav-links");

menuBtn.addEventListener("click", () => {
    navLinks.classList.toggle("show");
});
